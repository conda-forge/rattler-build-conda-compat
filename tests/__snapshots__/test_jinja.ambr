    - context:
        version: 5.1.0
      package:
        name: jolt-physics
        version: 5.1.0
      source:
        - url: https://github.com/jrouwe/JoltPhysics/archive/refs/tags/v5.1.0.zip
          sha256: 10fcc863ae2b9d48c2f22d8b0204034820e57a55f858b7c388ac9579d8cf4095
        - if: win
          then:
            url: https://win.com/jolt-physics.zip
            sha256: 10fcc863ae2b9d48c2f22d8b0204034820e57a55f858b7c388ac9579d8cf4095
      requirements:
        build:
          - cxx_compiler_stub
          - c_stdlib_stub
          - cmake
          - ninja
          - if: cuda
            then:
              - cuda-compiler
        host:
          - compatible_pin cmake
          - subpackage_pin None
      build:
        number: 0
        script:
          - if: win
            then: "cmake -GNinja ^\n    %CMAKE_ARGS% ^\n    -DCMAKE_INSTALL_PREFIX=%LIBRARY_PREFIX% ^\n    -DBUILD_SHARED_LIBS=ON ^\n    -DCMAKE_BUILD_TYPE=Distribution ^\n    -DCROSS_PLATFORM_DETERMINISTIC=ON ^\n    -DTARGET_VIEWER=OFF ^\n    -DTARGET_SAMPLES=OFF ^\n    -DTARGET_HELLO_WORLD=OFF ^\n    -DTARGET_UNIT_TESTS=OFF
              ^\n    -DTARGET_PERFORMANCE_TEST=OFF ^\n    -S %SRC_DIR%\\Build\ncmake --build . --target install\n"
            else: "cmake -GNinja \\\n    $CMAKE_ARGS \\\n    -DCMAKE_INSTALL_PREFIX=$PREFIX \\\n    -DBUILD_SHARED_LIBS=ON \\\n    -DCMAKE_BUILD_TYPE=Distribution \\\n    -DCROSS_PLATFORM_DETERMINISTIC=ON \\\n    -DTARGET_VIEWER=OFF \\\n    -DTARGET_SAMPLES=OFF \\\n    -DTARGET_HELLO_WORLD=OFF \\\n    -DTARGET_UNIT_TESTS=OFF
              \\\n    -DTARGET_PERFORMANCE_TEST=OFF \\\n    -S $SRC_DIR/Build\ncmake --build . --target install\n"
      about:
        homepage: https://github.com/jrouwe/JoltPhysics
        license: MIT
        license_file: LICENSE
        summary: A multi core friendly rigid body physics and collision detection library.
        description: A multi core friendly rigid body physics and collision detection library. Written in C++. Suitable for games and VR applications. Used by Horizon Forbidden West.
        documentation: https://jrouwe.github.io/JoltPhysics/
        repository: https://github.com/jrouwe/JoltPhysics
      extra:
        recipe-maintainers:
          - baszalmstra
